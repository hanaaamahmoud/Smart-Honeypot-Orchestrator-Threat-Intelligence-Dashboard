{
"$schema": "http://json-schema.org/draft-07/schema#",
"title": "Temporal Analytics Handoff",
"type": "object",
"required": ["contract_name", "contract_version", "generated_at", "trends", "periods"],
"properties": {
"contract_name": { "type": "string" },
"contract_version": { "type": "string" },
"generated_at": { "type": "string" },
"trend_type": { "enum": ["DAILY"] },
"summary": {
"type": "object",
"properties": {
"total_days": { "type": "integer" },
"total_sessions": { "type": "integer" },
"total_events": { "type": "integer" },
"total_active_periods": { "type": "integer" },
"largest_gap_days": { "type": "integer" },
"date_range": { "type": "object" }
}
},
"highlights": { "type": "object" },
"periods": { "type": "array" },
"trends": {
"type": "array",
"items": {
"type": "object",
"required": ["trend_date", "session_count", "total_events", "avg_session_duration_seconds", "event_count", "unique_sessions", "trend_type"],
"properties": {
"trend_date": { "type": "string" },
"session_count": { "type": "integer", "minimum": 0 },
"total_events": { "type": "integer", "minimum": 0 },
"avg_session_duration_seconds": { "type": "number", "minimum": 0 },
"event_count": { "type": "integer", "minimum": 0 },
"unique_sessions": { "type": "integer", "minimum": 0 },
"trend_type": { "enum": ["DAILY"] }
}
}
}
}
}
