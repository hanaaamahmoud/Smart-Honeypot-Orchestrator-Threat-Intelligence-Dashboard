{
"$schema": "http://json-schema.org/draft-07/schema#",
"title": "Session Replay Detail",
"type": "object",
"required": ["id", "summary", "narrative", "events"],
"properties": {
"id": { "type": "string" },
"summary": { "type": "object" },
"narrative": {
"type": "object",
"required": ["steps", "total_steps"],
"properties": {
"steps": { "type": "array" },
"phases": { "type": "array" },
"total_steps": { "type": "integer" }
}
},
"events": { "type": "array" }
}
}
