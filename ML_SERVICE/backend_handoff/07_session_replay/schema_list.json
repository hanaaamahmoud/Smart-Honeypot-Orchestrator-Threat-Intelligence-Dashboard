{
"$schema": "http://json-schema.org/draft-07/schema#",
"title": "Session Replay List",
"type": "object",
"required": ["contract_name", "contract_version", "generated_at", "total_sessions", "sessions"],
"properties": {
"contract_name": { "type": "string" },
"contract_version": { "type": "string" },
"generated_at": { "type": "string" },
"total_sessions": { "type": "integer" },
"replay_worthy_count": { "type": "integer" },
"sessions": {
"type": "array",
"items": {
"type": "object",
"required": ["id", "events", "has_replay"],
"properties": {
"id": { "type": "string" },
"events": { "type": "integer", "minimum": 0 },
"duration": { "type": "number", "minimum": 0 },
"honeypot": { "type": ["string", "null"] },
"protocol": { "type": ["string", "null"] },
"country": { "type": ["string", "null"] },
"attack": { "type": ["string", "null"] },
"mitre": { "type": ["string", "null"] },
"severity": { "type": ["string", "null"] },
"flags": { "type": "object" },
"has_replay": { "type": "boolean" }
}
}
}
}
}
